# App
APP_NAME=AVSS
APP_ENV=development
DEBUG=True
API_PREFIX=/api/v1

# Database
POSTGRES_USER=avss_user
POSTGRES_PASSWORD=avss_password
POSTGRES_DB=avss_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://avss_user:avss_password@localhost:5432/avss_db

# JWT Auth (used starting Module 2)
SECRET_KEY=change_this_to_a_long_random_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS
FRONTEND_ORIGIN=http://localhost:3000
