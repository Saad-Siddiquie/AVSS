# App
APP_NAME=AVSS
APP_ENV=development
DEBUG=True
API_PREFIX=/api/v1

# Database
POSTGRES_USER=avss_user
POSTGRES_PASSWORD=avss_password
POSTGRES_DB=avss_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://avss_user:avss_password@localhost:5432/avss_db

# JWT Auth (used starting Module 2)
SECRET_KEY=change_this_to_a_long_random_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS
FRONTEND_ORIGIN=http://localhost:3000

# AI — Wildtrack person detector (must match training: imgsz 640)
# AVSS_PERSON_WEIGHTS=weights/wildtrack_best.pt
# AVSS_PERSON_CONF=0.35
# AVSS_PERSON_IOU=0.50
# AVSS_PERSON_IMGSZ=640
# AVSS_PERSON_MAX_DET=100
# AVSS_FACE_CONF=0.40
# AVSS_FACE_IN_PERSON_CONF=0.30
# AVSS_FACE_IMGSZ=640
# AVSS_TRACK_BUFFER=45
